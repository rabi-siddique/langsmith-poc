# LangSmith: smith.langchain.com -> Settings -> API Keys
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
# Only if your key is org-scoped / linked to several workspaces
# LANGSMITH_WORKSPACE_ID=

# OpenRouter: openrouter.ai -> Keys
OPENROUTER_API_KEY=
# Any model that supports tool calling. Free ones end in ":free"; browse
# https://openrouter.ai/models?supported_parameters=tools
# Claude works too, e.g. anthropic/<model> (paid).
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Optional
# DATASET_NAME=ymax-tool-selection
# YMAX_INSTRUCTIONS_DIR=../ymax-mcp-infra/services/mcp-server/src/instructions
