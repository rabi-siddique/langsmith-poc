# Which model the agent uses: openrouter (default), gemini, mistral, cloudflare,
# nvidia, ollama-cloud, zai, kilo, ovh or local. kilo, ovh and local need no key.
# The list is in src/mastra/agents/agent.ts.
AGENT_MODEL=openrouter

# Free OpenRouter models. Create the key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=

# Langfuse tracing. Create the keys in Langfuse under Settings > API Keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Use your own URL for a self-hosted or non-EU Langfuse.
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# LangSmith tracing and live evals. Create the key in LangSmith under
# Settings > API Keys.
LANGSMITH_API_KEY=
# Only for an EU or self-hosted LangSmith. The default is https://api.smith.langchain.com.
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Google Gemini models. Create the key at https://aistudio.google.com.
GOOGLE_API_KEY=

# Mistral models. Create the key at https://console.mistral.ai.
MISTRAL_API_KEY=

# NVIDIA NIM models. Join the free NVIDIA Developer Program, then create the
# key at https://build.nvidia.com.
NVIDIA_API_KEY=

# Ollama Cloud models. Create the key at https://ollama.com/settings/keys.
OLLAMA_API_KEY=

# Z AI (Zhipu) models. Create the key at https://z.ai/manage-apikey/apikey-list.
ZHIPU_API_KEY=

# Cloudflare Workers AI models. Create the token at
# https://dash.cloudflare.com/profile/api-tokens with the "Workers AI" template.
# Also needed for `yarn eval`, whose judge always runs on Cloudflare.
CLOUDFLARE_API_KEY=
# The long ID in the dashboard URL after dash.cloudflare.com/.
CLOUDFLARE_ACCOUNT_ID=
